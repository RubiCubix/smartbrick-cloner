<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SmartBrick Cloner"
            android:textSize="22sp"
            android:textStyle="bold"
            android:paddingBottom="4dp" />

        <TextView
            android:id="@+id/tagInfoText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ready to clone SLIX2 bricks."
            android:textSize="14sp"
            android:fontFamily="monospace"
            android:paddingBottom="24dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Brick Library"
            android:textSize="20sp"
            android:textStyle="bold"
            android:paddingBottom="8dp" />

        <Button
            android:id="@+id/loadFileButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Open Brick Dump File (.txt)" />

        <TextView
            android:id="@+id/copyStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No brick data loaded."
            android:textSize="14sp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp" />

        <Button
            android:id="@+id/copyButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Copy from physical brick" />

        <Button
            android:id="@+id/writeCopyButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Write to target sticker"
            android:enabled="false"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/viewDataButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Inspect data"
            android:enabled="false"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/saveFileButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save to file (.txt)"
            android:enabled="false"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/cancelWriteButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cancel Operation"
            android:visibility="gone"
            android:layout_marginTop="8dp" />

    </LinearLayout>
</ScrollView>
